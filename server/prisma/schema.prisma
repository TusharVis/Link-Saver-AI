generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  image       String?      @db.LongText
  bookmarks   Bookmark[]
  collections Collection[]
}

model Collection {
  id        Int        @id @default(autoincrement())
  name      String
  userId    Int
  createdAt DateTime   @default(now())
  bookmarks Bookmark[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId], map: "Collection_userId_fkey")
}

model Bookmark {
  id           Int         @id @default(autoincrement())
  title        String
  url          String
  description  String?
  category     String
  favorite     Boolean     @default(false)
  userId       Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  image        String?
  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([collectionId], map: "Bookmark_collectionId_fkey")
  @@index([userId], map: "Bookmark_userId_fkey")
}
